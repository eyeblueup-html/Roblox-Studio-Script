mouse.Button1Down:Connect(function()
	if dragging then
		return
	end

	if mouseOverToolbar() then
		return
	end

	local target = mouse.Target

	local shift =
		UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)

	if validTarget(target) then
		if shift then
			toggleSelection(target)
		else
			selectOnly(target)
		end
	elseif not shift then
		clearSelection()
	end
end)

handles.MouseButton1Down:Connect(function(face)
	if #selection == 0 then
		return
	end

	dragging = true
	dragMode = tool

	captureDragData()

	hoverBox.Adornee = nil
end)

handles.MouseDrag:Connect(function(face, distance)
	if not dragging then
		return
	end

	if #selection == 0 then
		return
	end

	if dragMode == "Move" then
		moveSelection(face, distance)
	elseif dragMode == "Scale" then
		scaleSelection(face, distance)
	end

	updateProxy()
end)

handles.MouseButton1Up:Connect(function()
	dragging = false
	dragMode = nil
	dragData = {}

	updateProxy()
	updateHandles()
end)

rotateHandles.MouseButton1Down:Connect(function(axis)
	if #selection == 0 then
		return
	end

	dragging = true
	dragMode = "Rotate"

	captureDragData()

	hoverBox.Adornee = nil
end)

rotateHandles.MouseDrag:Connect(function(axis, relativeAngle, deltaRadius)
	if not dragging then
		return
	end

	if #selection == 0 then
		return
	end

	rotateSelection(axis, relativeAngle)
	updateProxy()
end)

rotateHandles.MouseButton1Up:Connect(function()
	dragging = false
	dragMode = nil
	dragData = {}

	updateProxy()
	updateHandles()
end)

local function keybindAction(actionName, inputState, inputObject)
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end

	if UserInputService:GetFocusedTextBox() then
		return Enum.ContextActionResult.Pass
	end

	if inputObject.KeyCode == Enum.KeyCode.One then
		setTool("Move")
		return Enum.ContextActionResult.Sink
	end

	if inputObject.KeyCode == Enum.KeyCode.Two then
		setTool("Scale")
		return Enum.ContextActionResult.Sink
	end

	if inputObject.KeyCode == Enum.KeyCode.Three then
		setTool("Rotate")
		return Enum.ContextActionResult.Sink
	end

	if inputObject.KeyCode == Enum.KeyCode.Delete
		or inputObject.KeyCode == Enum.KeyCode.Backspace then
		deleteSelected()
		return Enum.ContextActionResult.Sink
	end

	return Enum.ContextActionResult.Pass
end

ContextActionService:BindActionAtPriority(
	"BuildToolKeyboard",
	keybindAction,
	false,
	3000,
	Enum.KeyCode.One,
	Enum.KeyCode.Two,
	Enum.KeyCode.Three,
	Enum.KeyCode.Delete,
	Enum.KeyCode.Backspace
)

RunService.RenderStepped:Connect(function()
	if dragging then
		if hoverBox.Adornee ~= nil then
			hoverBox.Adornee = nil
		end
		return
	end

	local target = mouse.Target

	if validTarget(target) and not isSelected(target) then
		if hoverBox.Adornee ~= target then
			hoverBox.Adornee = target
		end
	else
		if hoverBox.Adornee ~= nil then
			hoverBox.Adornee = nil
		end
	end
end)

local lastSelectionCount = 0
local lastSelected = nil

RunService.Heartbeat:Connect(function()
	local changed = false

	for i = #selection, 1, -1 do
		local part = selection[i]

		if not part or not part.Parent then
			table.remove(selection, i)
			changed = true
		end
	end

	if selected and not selected.Parent then
		selected = selection[#selection]
		changed = true
	end

	if #selection ~= lastSelectionCount then
		changed = true
	end

	if selected ~= lastSelected then
		changed = true
	end

	if changed then
		lastSelectionCount = #selection
		lastSelected = selected

		updateSelectionVisuals()
		updateAnchorDisplay()
		updateProxy()
		updateHandles()
	end
end)

setTool("Move")
updateSelectionVisuals()
updateAnchorDisplay()
